package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_library_static {
    name: "aemu",
    vendor: true,
    cpp_std: "c++17",
    host_supported: true,
    defaults: [
        "aosp_mesa3d_cpp_link_args",
        "aosp_mesa3d_cpp_project_args",
    ],
    header_libs: select(arch(), {
        "arm64": [
            "inc_aemu",
        ],
        "x86_64": [
            "inc_aemu",
        ],
        "x86": [
            "inc_aemu",
        ],
        default: [],
    }),
    srcs: select(arch(), {
        "arm64": [
            "Stream.cpp",
            "ring_buffer.cpp",
        ],
        "x86_64": [
            "Stream.cpp",
            "ring_buffer.cpp",
        ],
        "x86": [
            "Stream.cpp",
            "ring_buffer.cpp",
        ],
        default: [],
    }),
}
