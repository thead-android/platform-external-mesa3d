        "vk_ycbcr_conversion.c",
    ] + select(os(), {
        "android": [
            "vk_android.c",
        ],
        default: [],
    }),
    static_libs: [
        "blake3",
        "mesa_util",
        "mesa_util_c11",
        "mesa_util_simd",
        "vulkan_util",
    ] + select((arch(), os(), soong_config_variable("aosp_mesa3d", "perfetto")), {
        ("arm64", "android", "true"): [
            "libperfetto_client_experimental",
        ],
        ("x86_64", "android", "true"): [
            "libperfetto_client_experimental",
        ],
        ("x86", "android", "true"): [
            "libperfetto_client_experimental",
        ],
        (default, default, default): [],
    }) + select(os(), {
        "android": [
            "_mesa_u_gralloc",
        ],
        default: [],
    }) + select(arch(), {
        "x86_64": [
            "mesa_util_clflush",
            "mesa_util_clflushopt",
        ],
        "x86": [
            "mesa_util_clflush",
            "mesa_util_clflushopt",
        ],
        default: [],
    }),
    shared_libs: [
        "libdrm",
        "libz",
        "libzstd",
    ] + select(os(), {
        "android": [
            "libcutils",
            "libhardware",
            "liblog",
            "libnativewindow",
            "libsync",
            "libui",
        ],
        default: [],
    }),
}

