genrule {
    name: "lvp_drirc_headers",
    out: [
        "src/gallium/frontends/lavapipe/lvp_drirc.h",
    ],
    srcs: [
        "00-lavapipe-defaults.conf",
    ],
    tools: [
        "lvp_drirc_py_binary",
    ],
    export_include_dirs: [
        "src",
        "src/gallium",
        "src/gallium/frontends",
        "src/gallium/frontends/lavapipe",
    ],
    cmd: "$(location lvp_drirc_py_binary) --import-path $(genDir)/src/util " +
        "--drirc-src $(genDir)/src/gallium/frontends/lavapipe/lvp_drirc.c " +
        "--drirc-hdr $(location src/gallium/frontends/lavapipe/lvp_drirc.h) " +
        "--validate $(location 00-lavapipe-defaults.conf)",
}

genrule {
    name: "lvp_drirc_impl",
