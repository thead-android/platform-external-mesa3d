    ],
    export_include_dirs: [
        "src",
        "src/gallium",
        "src/gallium/frontends",
        "src/gallium/frontends/lavapipe",
    ],
    cmd: "$(location vk_entrypoints_py_binary) --xml $(location :vk_api_xml) " +
        "--proto --weak --out-h $(location " +
        "src/gallium/frontends/lavapipe/lvp_entrypoints.h) --out-c " +
        "$(genDir)/src/gallium/frontends/lavapipe/lvp_entrypoints.c --prefix " +
        "lvp --beta false",
}

