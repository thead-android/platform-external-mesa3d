package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_library_headers {
    name: "inc_include",
    vendor: true,
    host_supported: true,
    export_include_dirs: [
        ".",
    ] + select((arch(), os()), {
        ("x86_64", "linux_glibc"): [
            "android_stub",
        ],
        ("x86_64", "linux_musl"): [
            "android_stub",
        ],
        ("arm64", "linux_musl"): [
            "android_stub",
        ],
        (default, default): [],
    }),
}
